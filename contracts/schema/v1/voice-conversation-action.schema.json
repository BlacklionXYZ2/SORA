{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "VoiceControlStatus": {
      "enum": [
        "applied",
        "clarification_required",
        "unsupported",
        "not_applied"
      ],
      "title": "VoiceControlStatus",
      "type": "string"
    },
    "VoiceConversationIntent": {
      "description": "Deterministic high-level handling for a finalized spoken utterance.",
      "enum": [
        "dialogue",
        "stop_speaking",
        "steer_task",
        "cancel_task",
        "new_work"
      ],
      "title": "VoiceConversationIntent",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "intent": {
      "$ref": "#/$defs/VoiceConversationIntent"
    },
    "message": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "output_stopped": {
      "default": false,
      "title": "Output Stopped",
      "type": "boolean"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "status": {
      "$ref": "#/$defs/VoiceControlStatus"
    },
    "task_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "intent",
    "status",
    "message"
  ],
  "title": "VoiceConversationAction",
  "type": "object"
}
