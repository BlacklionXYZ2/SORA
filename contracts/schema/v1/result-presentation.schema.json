{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "PresentationMode": {
      "enum": [
        "silent",
        "brief",
        "explain",
        "walkthrough"
      ],
      "title": "PresentationMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor_provenance": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "attention_required": {
      "default": false,
      "title": "Attention Required",
      "type": "boolean"
    },
    "attention_target_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "explanation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Explanation"
    },
    "mode": {
      "$ref": "#/$defs/PresentationMode"
    },
    "physical_cues": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Physical Cues",
      "type": "array"
    },
    "presentation_id": {
      "$ref": "#/$defs/Identifier"
    },
    "result_id": {
      "$ref": "#/$defs/Identifier"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "significance": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Significance",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/NonEmptyText"
    }
  },
  "required": [
    "presentation_id",
    "result_id",
    "mode",
    "significance",
    "actor_provenance",
    "summary"
  ],
  "title": "ResultPresentation",
  "type": "object"
}
