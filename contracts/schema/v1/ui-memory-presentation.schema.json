{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Generation": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activation": {
      "enum": [
        "explicit",
        "passive"
      ],
      "title": "Activation",
      "type": "string"
    },
    "dialogue_request_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expected_version": {
      "minimum": 1,
      "title": "Expected Version",
      "type": "integer"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "host_id": {
      "format": "uuid",
      "title": "Host Id",
      "type": "string"
    },
    "instance_id": {
      "format": "uuid",
      "title": "Instance Id",
      "type": "string"
    },
    "lease_id": {
      "format": "uuid",
      "title": "Lease Id",
      "type": "string"
    },
    "memory_id": {
      "$ref": "#/$defs/Identifier"
    },
    "operation": {
      "const": "select-highlight",
      "default": "select-highlight",
      "title": "Operation",
      "type": "string"
    },
    "origin": {
      "enum": [
        "owner",
        "companion"
      ],
      "title": "Origin",
      "type": "string"
    },
    "panel": {
      "const": "memory",
      "default": "memory",
      "title": "Panel",
      "type": "string"
    },
    "registry_generation": {
      "$ref": "#/$defs/Generation"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    }
  },
  "required": [
    "instance_id",
    "request_id",
    "memory_id",
    "expected_version",
    "host_id",
    "lease_id",
    "registry_generation",
    "origin",
    "activation",
    "expires_at"
  ],
  "title": "UiMemoryPresentation",
  "type": "object"
}
