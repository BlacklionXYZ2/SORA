{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "pending",
        "approved",
        "denied",
        "expired",
        "cancelled"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "CapabilityOperation": {
      "enum": [
        "tool.invoke",
        "path.read",
        "path.write",
        "desktop.observe",
        "desktop.present",
        "desktop.navigate",
        "desktop.interact"
      ],
      "title": "CapabilityOperation",
      "type": "string"
    },
    "CapabilityRequest": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "operation": {
          "$ref": "#/$defs/CapabilityOperation"
        },
        "owner_id": {
          "$ref": "#/$defs/Identifier"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "request_id": {
          "$ref": "#/$defs/Identifier"
        },
        "resource": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        }
      },
      "required": [
        "request_id",
        "owner_id",
        "device_id",
        "operation",
        "resource"
      ],
      "title": "CapabilityRequest",
      "type": "object"
    },
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "$ref": "#/$defs/Identifier"
    },
    "capability": {
      "$ref": "#/$defs/CapabilityRequest"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decided At"
    },
    "decided_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "status": {
      "$ref": "#/$defs/ApprovalStatus"
    }
  },
  "required": [
    "approval_id",
    "capability",
    "status",
    "created_at",
    "expires_at"
  ],
  "title": "ApprovalRequest",
  "type": "object"
}
