{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "default": 1.0,
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "crop_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "device_id": {
      "$ref": "#/$defs/Identifier"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "owner_id": {
      "$ref": "#/$defs/Identifier"
    },
    "pinned": {
      "default": false,
      "title": "Pinned",
      "type": "boolean"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "screen_rect": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Screen Rect"
    },
    "source": {
      "enum": [
        "hover",
        "click",
        "selection",
        "circle",
        "app",
        "task",
        "document",
        "object"
      ],
      "title": "Source",
      "type": "string"
    },
    "target_id": {
      "$ref": "#/$defs/Identifier"
    },
    "ui_element": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ui Element"
    },
    "window_title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window Title"
    }
  },
  "required": [
    "target_id",
    "source",
    "created_at",
    "expires_at",
    "owner_id",
    "device_id"
  ],
  "title": "AttentionTarget",
  "type": "object"
}
