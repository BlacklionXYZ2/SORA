{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "VoiceReferenceStatus": {
      "enum": [
        "resolved",
        "clarification_required"
      ],
      "title": "VoiceReferenceStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reason": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "reference_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reference_spoken_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Spoken At"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "status": {
      "$ref": "#/$defs/VoiceReferenceStatus"
    }
  },
  "required": [
    "status",
    "reason"
  ],
  "title": "VoiceReferenceResolution",
  "type": "object"
}
