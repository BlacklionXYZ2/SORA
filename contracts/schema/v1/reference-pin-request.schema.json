{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "reference_id": {
      "$ref": "#/$defs/Identifier"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "ttl_seconds": {
      "default": 3600,
      "exclusiveMinimum": 0,
      "maximum": 86400,
      "title": "Ttl Seconds",
      "type": "number"
    }
  },
  "required": [
    "reference_id"
  ],
  "title": "ReferencePinRequest",
  "type": "object"
}
