{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "SessionStatus": {
      "enum": [
        "active",
        "lost",
        "closed"
      ],
      "title": "SessionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context_fingerprint": {
      "maxLength": 128,
      "minLength": 16,
      "title": "Context Fingerprint",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "last_seen_at": {
      "format": "date-time",
      "title": "Last Seen At",
      "type": "string"
    },
    "native_session_id": {
      "$ref": "#/$defs/Identifier"
    },
    "owner_id": {
      "$ref": "#/$defs/Identifier"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider": {
      "$ref": "#/$defs/Identifier"
    },
    "resume_supported": {
      "title": "Resume Supported",
      "type": "boolean"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "session_id": {
      "$ref": "#/$defs/Identifier"
    },
    "status": {
      "$ref": "#/$defs/SessionStatus"
    },
    "task_id": {
      "$ref": "#/$defs/Identifier"
    }
  },
  "required": [
    "session_id",
    "task_id",
    "owner_id",
    "provider",
    "native_session_id",
    "status",
    "resume_supported",
    "context_fingerprint",
    "created_at",
    "last_seen_at"
  ],
  "title": "AgentSessionRecord",
  "type": "object"
}
