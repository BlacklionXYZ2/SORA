{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "VoiceControlStatus": {
      "enum": [
        "applied",
        "clarification_required",
        "unsupported",
        "not_applied"
      ],
      "title": "VoiceControlStatus",
      "type": "string"
    },
    "VoiceConversationAction": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "$ref": "#/$defs/VoiceConversationIntent"
        },
        "message": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "output_stopped": {
          "default": false,
          "title": "Output Stopped",
          "type": "boolean"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "status": {
          "$ref": "#/$defs/VoiceControlStatus"
        },
        "task_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "intent",
        "status",
        "message"
      ],
      "title": "VoiceConversationAction",
      "type": "object"
    },
    "VoiceConversationIntent": {
      "description": "Deterministic high-level handling for a finalized spoken utterance.",
      "enum": [
        "dialogue",
        "stop_speaking",
        "steer_task",
        "cancel_task",
        "new_work"
      ],
      "title": "VoiceConversationIntent",
      "type": "string"
    },
    "VoiceEmotion": {
      "description": "Coarse utterance intent; never a per-frame animation instruction.",
      "enum": [
        "neutral",
        "warm",
        "cheerful",
        "concerned",
        "focused"
      ],
      "title": "VoiceEmotion",
      "type": "string"
    },
    "VoicePlaybackCommand": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "device_generation": {
          "minimum": 1,
          "title": "Device Generation",
          "type": "integer"
        },
        "emotion": {
          "$ref": "#/$defs/VoiceEmotion",
          "default": "warm"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "output_device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "output_epoch": {
          "minimum": 0,
          "title": "Output Epoch",
          "type": "integer"
        },
        "playback_id": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "text": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "utterance_id": {
          "$ref": "#/$defs/Identifier"
        },
        "voice_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "playback_id",
        "session_id",
        "utterance_id",
        "output_device_id",
        "device_generation",
        "output_epoch",
        "voice_id",
        "text",
        "created_at",
        "expires_at"
      ],
      "title": "VoicePlaybackCommand",
      "type": "object"
    },
    "VoicePlaybackState": {
      "enum": [
        "queued",
        "started",
        "completed",
        "failed"
      ],
      "title": "VoicePlaybackState",
      "type": "string"
    },
    "VoiceReferenceResolution": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "reference_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_spoken_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Spoken At"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "status": {
          "$ref": "#/$defs/VoiceReferenceStatus"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "VoiceReferenceResolution",
      "type": "object"
    },
    "VoiceReferenceStatus": {
      "enum": [
        "resolved",
        "clarification_required"
      ],
      "title": "VoiceReferenceStatus",
      "type": "string"
    },
    "VoiceSessionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "active_generation_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "active_playback_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finalized_utterances": {
          "minimum": 0,
          "title": "Finalized Utterances",
          "type": "integer"
        },
        "generation_cancel_requested": {
          "default": false,
          "title": "Generation Cancel Requested",
          "type": "boolean"
        },
        "input_device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "input_generation": {
          "minimum": 1,
          "title": "Input Generation",
          "type": "integer"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "opened_at": {
          "format": "date-time",
          "title": "Opened At",
          "type": "string"
        },
        "output_device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "output_epoch": {
          "minimum": 0,
          "title": "Output Epoch",
          "type": "integer"
        },
        "output_generation": {
          "minimum": 1,
          "title": "Output Generation",
          "type": "integer"
        },
        "output_suppressed": {
          "default": false,
          "title": "Output Suppressed",
          "type": "boolean"
        },
        "partial_text": {
          "anyOf": [
            {
              "maxLength": 16384,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Partial Text"
        },
        "partial_utterance_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "playback_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/VoicePlaybackState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "session_id": {
          "$ref": "#/$defs/Identifier"
        },
        "status": {
          "$ref": "#/$defs/VoiceSessionStatus"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "voice_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "session_id",
        "status",
        "input_device_id",
        "output_device_id",
        "input_generation",
        "output_generation",
        "language",
        "voice_id",
        "finalized_utterances",
        "output_epoch",
        "opened_at",
        "updated_at"
      ],
      "title": "VoiceSessionSnapshot",
      "type": "object"
    },
    "VoiceSessionStatus": {
      "enum": [
        "active",
        "input_unavailable",
        "output_unavailable",
        "devices_unavailable",
        "closed"
      ],
      "title": "VoiceSessionStatus",
      "type": "string"
    },
    "VoiceTranscriptDisposition": {
      "enum": [
        "partial_accepted",
        "finalized",
        "duplicate",
        "suppressed_echo",
        "interrupted"
      ],
      "title": "VoiceTranscriptDisposition",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assistant_message_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "assistant_text": {
      "anyOf": [
        {
          "maxLength": 16384,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Assistant Text"
    },
    "control": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoiceConversationAction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "disposition": {
      "$ref": "#/$defs/VoiceTranscriptDisposition"
    },
    "playback": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoicePlaybackCommand"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoiceReferenceResolution"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "session": {
      "$ref": "#/$defs/VoiceSessionSnapshot"
    },
    "user_message_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "disposition",
    "session"
  ],
  "title": "VoiceTurnResult",
  "type": "object"
}
