{
  "$defs": {
    "CapabilityCategory": {
      "enum": [
        "desktop",
        "files",
        "media",
        "tasks",
        "social",
        "calendar",
        "desktop_objects",
        "reasoning_agents"
      ],
      "title": "CapabilityCategory",
      "type": "string"
    },
    "CapabilityIndexEntry": {
      "additionalProperties": false,
      "properties": {
        "capability_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Capability Ids",
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/CapabilityCategory"
        },
        "summary": {
          "$ref": "#/$defs/NonEmptyText"
        }
      },
      "required": [
        "category",
        "summary"
      ],
      "title": "CapabilityIndexEntry",
      "type": "object"
    },
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "entries": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CapabilityIndexEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Version",
      "type": "string"
    }
  },
  "title": "CapabilityIndex",
  "type": "object"
}
