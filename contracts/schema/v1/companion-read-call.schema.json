{
  "$defs": {
    "FinishRead": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "finish",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "FinishRead",
      "type": "object"
    },
    "InspectWindow": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "inspect_window",
          "title": "Op",
          "type": "string"
        },
        "target": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "view": {
          "enum": [
            "summary",
            "controls",
            "text",
            "selection"
          ],
          "title": "View",
          "type": "string"
        }
      },
      "required": [
        "op",
        "target",
        "view"
      ],
      "title": "InspectWindow",
      "type": "object"
    },
    "ListFiles": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "op": {
          "const": "list_files",
          "title": "Op",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "op",
        "path"
      ],
      "title": "ListFiles",
      "type": "object"
    },
    "ListWindows": {
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "list_windows",
          "title": "Op",
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "ListWindows",
      "type": "object"
    },
    "ReadFile": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "default": 0,
          "maximum": 1048576,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "op": {
          "const": "read_file",
          "title": "Op",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "op"
      ],
      "title": "ReadFile",
      "type": "object"
    },
    "SearchFiles": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "mode": {
          "default": "name",
          "enum": [
            "name",
            "text"
          ],
          "title": "Mode",
          "type": "string"
        },
        "op": {
          "const": "search_files",
          "title": "Op",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "query": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "op",
        "path",
        "query"
      ],
      "title": "SearchFiles",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "finish": "#/$defs/FinishRead",
      "inspect_window": "#/$defs/InspectWindow",
      "list_files": "#/$defs/ListFiles",
      "list_windows": "#/$defs/ListWindows",
      "read_file": "#/$defs/ReadFile",
      "search_files": "#/$defs/SearchFiles"
    },
    "propertyName": "op"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ListWindows"
    },
    {
      "$ref": "#/$defs/InspectWindow"
    },
    {
      "$ref": "#/$defs/ListFiles"
    },
    {
      "$ref": "#/$defs/SearchFiles"
    },
    {
      "$ref": "#/$defs/ReadFile"
    },
    {
      "$ref": "#/$defs/FinishRead"
    }
  ],
  "title": "CompanionReadCall"
}
