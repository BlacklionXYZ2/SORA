    "ReadFile": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "default": 0,
          "maximum": 1048576,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "op": {
          "const": "read_file",
          "title": "Op",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "op"
      ],
      "title": "ReadFile",
      "type": "object"
    },
    "Remember": {
      "additionalProperties": false,
      "description": "SORA remembers this moment: a short title and a description written as a lasting fact.\n\nCore stores the memory with the whole turn: the owner's exact words, her reply, what was\nread, the images the brain saw and the owner's voice recording when there is one. The\ntitle and description are her note about it; the owner's words are kept verbatim beside it.",
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Description",
          "type": "string"
        },
        "op": {
          "const": "remember",
          "title": "Op",
          "type": "string"
        },
        "standing": {
          "default": false,
          "title": "Standing",
          "type": "boolean"
        },
        "title": {
          "maxLength": 80,
          "minLength": 2,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "op",
        "title",
        "description"
      ],
      "title": "Remember",
      "type": "object"
    },
    "RememberThought": {
      "additionalProperties": false,
      "description": "SORA keeps one of her own thoughts: an ordinary memory whose author is SORA.\n\nCore stores it after the reply, in her words, labelled as her thought (never as something\nthe owner said). The owner's own statements are remembered by Core separately.",
      "properties": {
        "op": {
          "const": "remember_thought",
          "title": "Op",
          "type": "string"
        },
        "thought": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Thought",
          "type": "string"
        }
      },
      "required": [
        "op",
        "thought"
      ],
      "title": "RememberThought",
      "type": "object"
    },
