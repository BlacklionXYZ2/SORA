      "required": [
        "op",
        "path",
        "query"
      ],
      "title": "SearchFiles",
      "type": "object"
    },
    "ViewWindow": {
      "additionalProperties": false,
      "description": "Look closer at one window: Core attaches a full-resolution image of it to the reply.\n\nEvery reply already sees a reduced image of the whole desktop. A null target means the\nwindow the owner is using, or used last before SORA.",
      "properties": {
        "op": {
          "const": "view_window",
          "title": "Op",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "op"
      ],
      "title": "ViewWindow",
      "type": "object"
    }
