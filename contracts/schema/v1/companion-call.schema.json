      "title": "Look",
      "type": "object"
    },
    "Move": {
      "additionalProperties": false,
      "description": "Walk or run SORA's avatar to a semantic destination that Core resolves to a point.\n\nThe model never supplies coordinates: Core knows the monitor layout and window positions,\nwhich a small model would guess badly.",
      "properties": {
        "monitor": {
          "default": "pointer",
          "enum": [
            "primary",
            "pointer",
            "other"
          ],
          "title": "Monitor",
          "type": "string"
        },
        "op": {
          "const": "move",
          "title": "Op",
          "type": "string"
        },
        "pace": {
          "default": "walk",
          "enum": [
            "walk",
            "run"
          ],
          "title": "Pace",
          "type": "string"
        },
        "place": {
          "default": "centre",
          "enum": [
            "left",
            "centre",
            "right"
          ],
          "title": "Place",
          "type": "string"
        },
        "target": {
          "default": "pointer",
          "enum": [
            "pointer",
            "window",
            "screen"
          ],
          "title": "Target",
          "type": "string"
        },
        "then": {
          "anyOf": [
            {
              "enum": [
                "sit",
                "lean",
                "climb",
                "stand"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Then"
        },
        "window": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        }
      },
      "required": [
        "op"
      ],
      "title": "Move",
      "type": "object"
    },
    "NoteGoal": {
      "additionalProperties": false,
      "description": "Progress towards a goal, drawn from issued memory references (m1, m2, ...).",
      "properties": {
        "memories": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Memories",
          "type": "array"
        },
        "op": {
          "const": "note_goal",
          "title": "Op",
          "type": "string"
        },
        "target": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "text": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "op",
        "target",
        "text"
      ],
      "title": "NoteGoal",
      "type": "object"
    },
