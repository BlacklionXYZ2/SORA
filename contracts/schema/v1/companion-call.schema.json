{
  "$defs": {
    "AddGoal": {
      "additionalProperties": false,
      "description": "Reflection: start one of HER OWN goals.",
      "properties": {
        "op": {
          "const": "add_goal",
          "title": "Op",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Text",
          "type": "string"
        },
        "why": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Why",
          "type": "string"
        }
      },
      "required": [
        "op",
        "text",
        "why"
      ],
      "title": "AddGoal",
      "type": "object"
    },
    "CloseGoal": {
      "additionalProperties": false,
      "description": "Goals end rather than vanish: achieved or dropped, with a reason; history is kept.",
      "properties": {
        "op": {
          "const": "close_goal",
          "title": "Op",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "achieved",
            "dropped"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        },
        "target": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "op",
        "target",
        "outcome",
        "reason"
      ],
      "title": "CloseGoal",
      "type": "object"
    },
    "Delegate": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "op": {
          "const": "delegate",
          "title": "Op",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project"
        },
        "provider": {
          "default": "auto",
          "enum": [
            "auto",
            "codex",
            "hermes",
            "antigravity",
            "claude",
            "custom-1",
            "custom-2",
            "custom-3",
            "custom-4"
          ],
          "title": "Provider",
          "type": "string"
        },
        "task": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "op",
        "task"
      ],
      "title": "Delegate",
      "type": "object"
    },
    "FindMemory": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "op": {
          "const": "find_memory",
          "title": "Op",
          "type": "string"
        },
        "query": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
      },
      "required": [
        "op",
        "query"
      ],
      "title": "FindMemory",
      "type": "object"
    },
    "FinishRead": {
