        },
        "target": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "view": {
          "enum": [
            "summary",
            "controls",
            "text",
            "selection"
          ],
          "title": "View",
          "type": "string"
        }
      },
      "required": [
        "op",
        "target",
        "view"
      ],
      "title": "InspectWindow",
      "type": "object"
    },
    "ListAgents": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "op": {
          "const": "list_agents",
          "title": "Op",
          "type": "string"
        },
        "provider": {
          "default": "auto",
          "enum": [
            "auto",
            "codex",
            "hermes",
            "antigravity",
            "claude",
            "custom-1",
            "custom-2",
            "custom-3",
            "custom-4"
