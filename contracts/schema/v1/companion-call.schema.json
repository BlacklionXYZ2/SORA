      "required": [
        "op",
        "target",
        "text",
        "reason"
      ],
      "title": "ReviseGoal",
      "type": "object"
    },
    "SearchFiles": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "mode": {
          "default": "name",
          "enum": [
            "name",
            "text"
          ],
          "title": "Mode",
          "type": "string"
        },
        "op": {
          "const": "search_files",
          "title": "Op",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "query": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Query",
          "type": "string"
        }
