{
  "$defs": {
    "AutomationBehavior": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "anyOf": [
            {
              "maxLength": 32,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "intent": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "kind": {
          "const": "agent_task",
          "default": "agent_task",
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "$ref": "#/$defs/Identifier",
          "default": "auto"
        },
        "working_directory": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Working Directory"
        },
        "workspace_mode": {
          "anyOf": [
            {
              "enum": [
                "workspace",
                "worktree"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workspace Mode"
        }
      },
      "required": [
        "intent"
      ],
      "title": "AutomationBehavior",
      "type": "object"
    },
    "AutomationDefinition": {
      "additionalProperties": false,
      "properties": {
        "automation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "entity_version": {
          "$ref": "#/$defs/Version"
        },
        "owner_id": {
          "$ref": "#/$defs/Identifier"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "spec": {
          "$ref": "#/$defs/AutomationSpec"
        },
        "state": {
          "enum": [
            "active",
            "paused",
            "deleted"
          ],
          "title": "State",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "automation_id",
        "owner_id",
        "project_id",
        "entity_version",
        "state",
        "spec",
        "created_at",
        "updated_at"
      ],
      "title": "AutomationDefinition",
      "type": "object"
    },
    "AutomationOccurrence": {
      "additionalProperties": false,
      "properties": {
        "automation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "behavior": {
          "$ref": "#/$defs/AutomationBehavior"
        },
        "definition_version": {
          "$ref": "#/$defs/Version"
        },
        "occurrence_id": {
          "$ref": "#/$defs/Identifier"
        },
        "origin": {
          "enum": [
            "scheduled",
            "manual"
          ],
          "title": "Origin",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "slot": {
          "$ref": "#/$defs/AutomationSlot"
        },
        "status": {
          "enum": [
            "reserved",
            "admitted",
            "skipped",
            "blocked",
            "failed",
            "unknown",
            "completed"
          ],
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "occurrence_id",
        "automation_id",
        "definition_version",
        "origin",
        "slot",
        "status",
        "behavior",
        "recorded_at"
      ],
      "title": "AutomationOccurrence",
      "type": "object"
    },
    "AutomationSlot": {
      "additionalProperties": false,
      "properties": {
        "decision_at": {
          "format": "date-time",
          "title": "Decision At",
          "type": "string"
        },
        "disposition": {
          "default": "due",
          "enum": [
            "due",
            "skip_nonexistent"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "planned_local": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$",
          "title": "Planned Local",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "slot_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Slot Key",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "slot_key",
        "decision_at",
        "planned_local",
        "timezone"
      ],
      "title": "AutomationSlot",
      "type": "object"
    },
    "AutomationSpec": {
      "additionalProperties": false,
      "properties": {
        "behavior": {
          "$ref": "#/$defs/AutomationBehavior"
        },
        "catch_up_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 0,
          "title": "Catch Up Seconds",
          "type": "integer"
        },
        "description": {
          "default": "",
          "maxLength": 2000,
          "title": "Description",
          "type": "string"
        },
        "missed_policy": {
          "default": "skip",
          "enum": [
            "skip",
            "run_once"
          ],
          "title": "Missed Policy",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "overlap_policy": {
          "const": "skip",
          "default": "skip",
          "title": "Overlap Policy",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "trigger": {
          "$ref": "#/$defs/AutomationTrigger"
        }
      },
      "required": [
        "name",
        "trigger",
        "behavior"
      ],
      "title": "AutomationSpec",
      "type": "object"
    },
    "AutomationTrigger": {
      "discriminator": {
        "mapping": {
          "daily": "#/$defs/DailyTrigger",
          "interval": "#/$defs/IntervalTrigger",
          "once": "#/$defs/OneOffTrigger",
          "weekly": "#/$defs/WeeklyTrigger"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/OneOffTrigger"
        },
        {
          "$ref": "#/$defs/DailyTrigger"
        },
        {
          "$ref": "#/$defs/WeeklyTrigger"
        },
        {
          "$ref": "#/$defs/IntervalTrigger"
        }
      ]
    },
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "DailyTrigger": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "daily",
          "title": "Kind",
          "type": "string"
        },
        "local_time": {
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Local Time",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "timezone",
        "kind",
        "local_time"
      ],
      "title": "DailyTrigger",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "IntervalTrigger": {
      "additionalProperties": false,
      "properties": {
        "anchor_at": {
          "format": "date-time",
          "title": "Anchor At",
          "type": "string"
        },
        "kind": {
          "const": "interval",
          "title": "Kind",
          "type": "string"
        },
        "seconds": {
          "maximum": 31536000,
          "minimum": 60,
          "title": "Seconds",
          "type": "integer"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "timezone",
        "kind",
        "anchor_at",
        "seconds"
      ],
      "title": "IntervalTrigger",
      "type": "object"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "OneOffTrigger": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "kind": {
          "const": "once",
          "title": "Kind",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "timezone",
        "kind",
        "at"
      ],
      "title": "OneOffTrigger",
      "type": "object"
    },
    "SchedulerState": {
      "enum": [
        "unavailable",
        "running",
        "degraded",
        "stopping",
        "stopped"
      ],
      "type": "string"
    },
    "Version": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "Weekday": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
    },
    "WeeklyTrigger": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "weekly",
          "title": "Kind",
          "type": "string"
        },
        "local_time": {
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
          "title": "Local Time",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "weekdays": {
          "items": {
            "$ref": "#/$defs/Weekday"
          },
          "maxItems": 7,
          "minItems": 1,
          "title": "Weekdays",
          "type": "array"
        }
      },
      "required": [
        "timezone",
        "kind",
        "local_time",
        "weekdays"
      ],
      "title": "WeeklyTrigger",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "create",
        "edit",
        "pause",
        "resume",
        "delete",
        "run_now"
      ],
      "title": "Action",
      "type": "string"
    },
    "committed_instance_id": {
      "format": "uuid",
      "title": "Committed Instance Id",
      "type": "string"
    },
    "definition": {
      "$ref": "#/$defs/AutomationDefinition"
    },
    "event_id": {
      "$ref": "#/$defs/Identifier"
    },
    "instance_id": {
      "format": "uuid",
      "title": "Instance Id",
      "type": "string"
    },
    "next_slot": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutomationSlot"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "default": "Historical saved receipt, not execution or current definition state.",
      "title": "Note",
      "type": "string"
    },
    "occurrence": {
      "anyOf": [
        {
          "$ref": "#/$defs/AutomationOccurrence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "projection_revision": {
      "minimum": 0,
      "title": "Projection Revision",
      "type": "integer"
    },
    "replayed": {
      "default": false,
      "title": "Replayed",
      "type": "boolean"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "scheduler_state": {
      "$ref": "#/$defs/SchedulerState",
      "default": "unavailable"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    }
  },
  "required": [
    "instance_id",
    "committed_instance_id",
    "request_id",
    "action",
    "definition",
    "next_slot",
    "projection_revision",
    "event_id"
  ],
  "title": "AutomationAck",
  "type": "object"
}
