{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Request an exact crop derived from one live circle target, never caller geometry.",
  "properties": {
    "attention_target_id": {
      "$ref": "#/$defs/Identifier"
    },
    "capture_id": {
      "$ref": "#/$defs/Identifier"
    },
    "fallback_reason": {
      "const": "uia_insufficient",
      "default": "uia_insufficient",
      "title": "Fallback Reason",
      "type": "string"
    },
    "request_id": {
      "$ref": "#/$defs/Identifier"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "ttl_seconds": {
      "default": 5.0,
      "exclusiveMinimum": 0,
      "maximum": 30,
      "title": "Ttl Seconds",
      "type": "number"
    }
  },
  "required": [
    "request_id",
    "attention_target_id",
    "capture_id"
  ],
  "title": "AttentionCropFallbackRequest",
  "type": "object"
}
