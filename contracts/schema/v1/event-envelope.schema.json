{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "JsonValue": {},
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "correlation_id": {
      "$ref": "#/$defs/Identifier"
    },
    "event_id": {
      "$ref": "#/$defs/Identifier"
    },
    "event_type": {
      "$ref": "#/$defs/Identifier"
    },
    "owner_id": {
      "$ref": "#/$defs/Identifier"
    },
    "payload": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Payload",
      "type": "object"
    },
    "revision": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Revision"
    },
    "run_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "stream_id": {
      "$ref": "#/$defs/Identifier"
    },
    "task_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "stream_id",
    "sequence",
    "timestamp",
    "owner_id",
    "source",
    "event_type",
    "correlation_id"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
