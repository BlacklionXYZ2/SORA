{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "explicit_reference_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "minimum_confidence": {
      "default": 0.75,
      "maximum": 1,
      "minimum": 0.5,
      "title": "Minimum Confidence",
      "type": "number"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "utterance": {
      "$ref": "#/$defs/NonEmptyText"
    }
  },
  "required": [
    "utterance"
  ],
  "title": "ReferenceResolveRequest",
  "type": "object"
}
