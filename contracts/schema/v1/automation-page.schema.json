{
  "$defs": {
    "AutomationSlot": {
      "additionalProperties": false,
      "properties": {
        "decision_at": {
          "format": "date-time",
          "title": "Decision At",
          "type": "string"
        },
        "disposition": {
          "default": "due",
          "enum": [
            "due",
            "skip_nonexistent"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "planned_local": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$",
          "title": "Planned Local",
          "type": "string"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "slot_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Slot Key",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "slot_key",
        "decision_at",
        "planned_local",
        "timezone"
      ],
      "title": "AutomationSlot",
      "type": "object"
    },
    "AutomationSummary": {
      "additionalProperties": false,
      "properties": {
        "automation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "entity_version": {
          "$ref": "#/$defs/Version"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "next_slot": {
          "anyOf": [
            {
              "$ref": "#/$defs/AutomationSlot"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "state": {
          "enum": [
            "active",
            "paused"
          ],
          "title": "State",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        },
        "trigger_kind": {
          "enum": [
            "once",
            "daily",
            "weekly",
            "interval"
          ],
          "title": "Trigger Kind",
          "type": "string"
        }
      },
      "required": [
        "automation_id",
        "name",
        "state",
        "entity_version",
        "trigger_kind",
        "timezone",
        "next_slot"
      ],
      "title": "AutomationSummary",
      "type": "object"
    },
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "SchedulerState": {
      "enum": [
        "unavailable",
        "running",
        "degraded",
        "stopping",
        "stopped"
      ],
      "type": "string"
    },
    "Version": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "properties": {
    "automations": {
      "items": {
        "$ref": "#/$defs/AutomationSummary"
      },
      "maxItems": 50,
      "title": "Automations",
      "type": "array"
    },
    "instance_id": {
      "format": "uuid",
      "title": "Instance Id",
      "type": "string"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "projection_revision": {
      "minimum": 0,
      "title": "Projection Revision",
      "type": "integer"
    },
    "scheduler_state": {
      "$ref": "#/$defs/SchedulerState",
      "default": "unavailable"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    }
  },
  "required": [
    "instance_id",
    "projection_revision",
    "observed_at",
    "automations"
  ],
  "title": "AutomationPage",
  "type": "object"
}
