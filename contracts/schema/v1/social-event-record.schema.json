{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "content": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "event_id": {
      "$ref": "#/$defs/Identifier"
    },
    "network": {
      "$ref": "#/$defs/Identifier"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "trust_classification": {
      "default": "untrusted_external",
      "enum": [
        "untrusted_external",
        "trusted_contact",
        "verified_peer"
      ],
      "title": "Trust Classification",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "network",
    "actor",
    "content",
    "timestamp"
  ],
  "title": "SocialEventRecord",
  "type": "object"
}
