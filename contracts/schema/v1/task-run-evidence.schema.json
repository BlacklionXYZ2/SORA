{
  "$defs": {
    "AgentRunRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "lease_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lease Expires At"
        },
        "local_delegation_epoch": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Local Delegation Epoch"
        },
        "native_session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider": {
          "$ref": "#/$defs/Identifier"
        },
        "run_id": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "task_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "attempt",
        "provider",
        "status"
      ],
      "title": "AgentRunRecord",
      "type": "object"
    },
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "ProviderOutcome": {
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "unknown"
      ],
      "title": "ProviderOutcome",
      "type": "string"
    },
    "RunArtifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "reference_ids": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 64,
          "title": "Reference Ids",
          "type": "array"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "title": "RunArtifact",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "pending",
        "launching",
        "running",
        "waiting_for_permission",
        "waiting_for_input",
        "cancel_requested",
        "interrupted",
        "uncertain",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RunArtifact"
      },
      "maxItems": 65,
      "title": "Artifacts",
      "type": "array"
    },
    "evidence_note": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "omitted_items": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Omitted Items",
      "type": "object"
    },
    "projection_revision": {
      "minimum": 0,
      "title": "Projection Revision",
      "type": "integer"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "run": {
      "$ref": "#/$defs/AgentRunRecord"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "task_id": {
      "$ref": "#/$defs/Identifier"
    },
    "text_truncated": {
      "default": false,
      "title": "Text Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "task_id",
    "run",
    "projection_revision",
    "evidence_note"
  ],
  "title": "TaskRunEvidence",
  "type": "object"
}
