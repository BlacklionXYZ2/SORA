{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bio": {
      "default": "",
      "title": "Bio",
      "type": "string"
    },
    "display_name": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "handle": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "network": {
      "$ref": "#/$defs/Identifier"
    },
    "profile_id": {
      "$ref": "#/$defs/Identifier"
    },
    "public_interests": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Public Interests",
      "type": "array"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    }
  },
  "required": [
    "profile_id",
    "network",
    "handle",
    "display_name"
  ],
  "title": "NetworkProfileProjection",
  "type": "object"
}
