  "additionalProperties": false,
  "properties": {
    "frame": {
      "$ref": "#/$defs/DesktopCaptureFrame"
    },
    "reference": {
      "$ref": "#/$defs/ReferenceCandidate"
    },
    "request_id": {
      "$ref": "#/$defs/Identifier"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "target": {
      "$ref": "#/$defs/AttentionTarget"
    }
  },
  "required": [
    "request_id",
    "target",
    "reference",
    "frame"
  ],
  "title": "AttentionCropFallbackResult",
  "type": "object"
}
