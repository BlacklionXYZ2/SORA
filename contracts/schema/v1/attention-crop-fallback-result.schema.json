          "type": "array"
        },
        "attention_target_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "content_reference_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "crop_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "desktop_target_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ReferenceKind"
        },
        "label": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "last_referenced_at": {
          "format": "date-time",
          "title": "Last Referenced At",
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "owner_id": {
          "$ref": "#/$defs/Identifier"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "$ref": "#/$defs/NonEmptyText",
          "default": "unspecified"
        },
        "reference_id": {
          "$ref": "#/$defs/Identifier"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "screen_rect": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScreenRect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "spatial_expires_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spatial Expires At"
        },
        "task_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "topology_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topology Revision"
        },
        "vision_evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "maxItems": 64,
          "title": "Vision Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "reference_id",
        "kind",
        "label",
        "owner_id",
        "device_id",
        "created_at",
        "expires_at",
        "last_referenced_at"
      ],
      "title": "ReferenceCandidate",
      "type": "object"
    },
    "ReferenceKind": {
      "enum": [
        "ui",
        "project",
        "file",
        "task",
        "document",
        "object",
        "artifact"
      ],
      "title": "ReferenceKind",
      "type": "string"
    },
    "ScreenRect": {
      "additionalProperties": false,
      "description": "Rectangle in physical screen pixels.",
      "properties": {
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "ScreenRect",
      "type": "object"
    }
