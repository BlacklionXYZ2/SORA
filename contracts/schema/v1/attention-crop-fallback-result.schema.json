{
  "$defs": {
    "AttentionTarget": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "crop_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "desktop_target_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "device_id": {
          "$ref": "#/$defs/Identifier"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "owner_id": {
          "$ref": "#/$defs/Identifier"
        },
        "pinned": {
          "default": false,
          "title": "Pinned",
          "type": "boolean"
        },
        "project_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provenance": {
          "$ref": "#/$defs/NonEmptyText",
          "default": "unspecified"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "screen_rect": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screen Rect"
        },
        "source": {
          "enum": [
            "hover",
            "click",
            "selection",
            "circle",
            "app",
            "task",
            "document",
            "object"
          ],
          "title": "Source",
          "type": "string"
        },
        "target_id": {
          "$ref": "#/$defs/Identifier"
        },
        "topology_revision": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topology Revision"
        },
        "ui_element": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ui Element"
        },
        "window_title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Title"
        }
      },
      "required": [
        "target_id",
        "source",
        "created_at",
        "expires_at",
        "owner_id",
        "device_id"
      ],
      "title": "AttentionTarget",
      "type": "object"
    },
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "DesktopCaptureFrame": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {
          "maximum": 16777216,
          "minimum": 1,
          "title": "Byte Length",
          "type": "integer"
        },
        "capture_id": {
          "$ref": "#/$defs/Identifier"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "desktop_target_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/Identifier"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "image_base64": {
          "maxLength": 22369624,
          "minLength": 1,
          "title": "Image Base64",
          "type": "string"
        },
        "mime_type": {
          "const": "image/png",
          "default": "image/png",
          "title": "Mime Type",
          "type": "string"
        },
        "process_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Process Id"
        },
        "provenance": {
          "$ref": "#/$defs/DesktopCaptureProvenance",
          "default": "windows_gdi_on_demand"
        },
        "region": {
          "$ref": "#/$defs/ScreenRect"
        },
        "schema_version": {
          "$ref": "#/$defs/ContractVersion",
          "default": "1.0"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DesktopCaptureSource"
        },
        "topology_revision": {
          "minimum": 1,
          "title": "Topology Revision",
          "type": "integer"
        },
        "window_handle": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window Handle"
        }
      },
      "required": [
        "capture_id",
        "source",
        "captured_at",
        "expires_at",
        "topology_revision",
        "region",
        "byte_length",
        "sha256",
        "image_base64"
      ],
      "title": "DesktopCaptureFrame",
      "type": "object"
    },
    "DesktopCaptureProvenance": {
      "enum": [
        "windows_gdi_on_demand",
        "deterministic_fixture"
      ],
      "type": "string"
    },
    "DesktopCaptureSource": {
      "enum": [
        "window",
        "region"
      ],
      "title": "DesktopCaptureSource",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "ReferenceCandidate": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/NonEmptyText"
          },
