{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "EntityPrecondition": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "$ref": "#/$defs/Identifier"
        },
        "entity_type": {
          "enum": [
            "task",
            "fact",
            "memory",
            "project",
            "conversation"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "expected_version": {
          "minimum": 0,
          "title": "Expected Version",
          "type": "integer"
        }
      },
      "required": [
        "entity_type",
        "entity_id",
        "expected_version"
      ],
      "title": "EntityPrecondition",
      "type": "object"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "ProposeFactOperation": {
      "additionalProperties": false,
      "properties": {
        "fact": {
          "$ref": "#/$defs/ProposedFact"
        },
        "operation": {
          "const": "propose_fact",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "operation",
        "operation_id",
        "fact"
      ],
      "title": "ProposeFactOperation",
      "type": "object"
    },
    "ProposeMemoryOperation": {
      "additionalProperties": false,
      "properties": {
        "memory": {
          "$ref": "#/$defs/ProposedMemory"
        },
        "operation": {
          "const": "propose_memory",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "operation",
        "operation_id",
        "memory"
      ],
      "title": "ProposeMemoryOperation",
      "type": "object"
    },
    "ProposedFact": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "content": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "epistemic_status": {
          "enum": [
            "assertion",
            "observation",
            "inference"
          ],
          "title": "Epistemic Status",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "content",
        "epistemic_status",
        "confidence"
      ],
      "title": "ProposedFact",
      "type": "object"
    },
    "ProposedMemory": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Identifier"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "retention": {
          "default": "durable",
          "enum": [
            "transient",
            "session",
            "durable"
          ],
          "title": "Retention",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "sensitivity": {
          "default": "normal",
          "enum": [
            "normal",
            "private",
            "secret"
          ],
          "title": "Sensitivity",
          "type": "string"
        }
      },
      "required": [
        "content",
        "scope"
      ],
      "title": "ProposedMemory",
      "type": "object"
    },
    "UpdateTaskMetadataOperation": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "update_task_metadata",
          "title": "Operation",
          "type": "string"
        },
        "operation_id": {
          "$ref": "#/$defs/Identifier"
        },
        "summary": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "task_id": {
          "$ref": "#/$defs/Identifier"
        }
      },
      "required": [
        "operation",
        "operation_id",
        "task_id",
        "summary"
      ],
      "title": "UpdateTaskMetadataOperation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_revision": {
      "minimum": 0,
      "title": "Base Revision",
      "type": "integer"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "idempotency_key": {
      "$ref": "#/$defs/Identifier"
    },
    "operations": {
      "items": {
        "discriminator": {
          "mapping": {
            "propose_fact": "#/$defs/ProposeFactOperation",
            "propose_memory": "#/$defs/ProposeMemoryOperation",
            "update_task_metadata": "#/$defs/UpdateTaskMetadataOperation"
          },
          "propertyName": "operation"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ProposeFactOperation"
          },
          {
            "$ref": "#/$defs/ProposeMemoryOperation"
          },
          {
            "$ref": "#/$defs/UpdateTaskMetadataOperation"
          }
        ]
      },
      "minItems": 1,
      "title": "Operations",
      "type": "array"
    },
    "patch_id": {
      "$ref": "#/$defs/Identifier"
    },
    "preconditions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EntityPrecondition"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "scope": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "source_run_id": {
      "$ref": "#/$defs/Identifier"
    }
  },
  "required": [
    "patch_id",
    "source_run_id",
    "base_revision",
    "scope",
    "provenance",
    "idempotency_key",
    "operations"
  ],
  "title": "PatchEnvelope",
  "type": "object"
}
