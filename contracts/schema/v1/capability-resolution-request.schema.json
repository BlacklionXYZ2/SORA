{
  "$defs": {
    "CapabilityScope": {
      "enum": [
        "local_owner",
        "local_restricted",
        "network_public",
        "remote_guest"
      ],
      "title": "CapabilityScope",
      "type": "string"
    },
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active_window": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Active Window"
    },
    "actor_id": {
      "$ref": "#/$defs/Identifier"
    },
    "attention_target_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "title": "Attention Target Refs",
      "type": "array"
    },
    "desktop_object_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Identifier"
      },
      "title": "Desktop Object Refs",
      "type": "array"
    },
    "intent": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "max_capabilities": {
      "default": 10,
      "minimum": 1,
      "title": "Max Capabilities",
      "type": "integer"
    },
    "request_id": {
      "$ref": "#/$defs/Identifier"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "scope": {
      "$ref": "#/$defs/CapabilityScope"
    },
    "session_id": {
      "$ref": "#/$defs/Identifier"
    }
  },
  "required": [
    "request_id",
    "actor_id",
    "session_id",
    "scope",
    "intent"
  ],
  "title": "CapabilityResolutionRequest",
  "type": "object"
}
