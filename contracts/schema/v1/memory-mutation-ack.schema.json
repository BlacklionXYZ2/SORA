{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "correct",
        "forget"
      ],
      "title": "Action",
      "type": "string"
    },
    "committed_at": {
      "format": "date-time",
      "title": "Committed At",
      "type": "string"
    },
    "committed_instance_id": {
      "format": "uuid",
      "title": "Committed Instance Id",
      "type": "string"
    },
    "content_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Content Sha256"
    },
    "entity_version": {
      "minimum": 2,
      "title": "Entity Version",
      "type": "integer"
    },
    "event_id": {
      "$ref": "#/$defs/Identifier"
    },
    "expected_version": {
      "minimum": 1,
      "title": "Expected Version",
      "type": "integer"
    },
    "instance_id": {
      "format": "uuid",
      "title": "Instance Id",
      "type": "string"
    },
    "memory_id": {
      "$ref": "#/$defs/Identifier"
    },
    "owner_id": {
      "$ref": "#/$defs/Identifier"
    },
    "project_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "projection_revision": {
      "minimum": 1,
      "title": "Projection Revision",
      "type": "integer"
    },
    "replayed": {
      "default": false,
      "title": "Replayed",
      "type": "boolean"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "retention_note": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "successor_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/Identifier"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "successor_version": {
      "anyOf": [
        {
          "const": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Successor Version"
    }
  },
  "required": [
    "instance_id",
    "committed_instance_id",
    "request_id",
    "owner_id",
    "memory_id",
    "action",
    "expected_version",
    "entity_version",
    "projection_revision",
    "event_id",
    "committed_at",
    "retention_note"
  ],
  "title": "MemoryMutationAck",
  "type": "object"
}
