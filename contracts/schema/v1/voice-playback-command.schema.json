{
  "$defs": {
    "ContractVersion": {
      "const": "1.0",
      "type": "string"
    },
    "Identifier": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "type": "string"
    },
    "NonEmptyText": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    },
    "VoiceEmotion": {
      "description": "Coarse utterance intent; never a per-frame animation instruction.",
      "enum": [
        "neutral",
        "warm",
        "cheerful",
        "concerned",
        "focused"
      ],
      "title": "VoiceEmotion",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "device_generation": {
      "minimum": 1,
      "title": "Device Generation",
      "type": "integer"
    },
    "emotion": {
      "$ref": "#/$defs/VoiceEmotion",
      "default": "warm"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "output_device_id": {
      "$ref": "#/$defs/Identifier"
    },
    "output_epoch": {
      "minimum": 0,
      "title": "Output Epoch",
      "type": "integer"
    },
    "playback_id": {
      "$ref": "#/$defs/Identifier"
    },
    "schema_version": {
      "$ref": "#/$defs/ContractVersion",
      "default": "1.0"
    },
    "session_id": {
      "$ref": "#/$defs/Identifier"
    },
    "text": {
      "$ref": "#/$defs/NonEmptyText"
    },
    "utterance_id": {
      "$ref": "#/$defs/Identifier"
    },
    "voice_id": {
      "$ref": "#/$defs/Identifier"
    }
  },
  "required": [
    "playback_id",
    "session_id",
    "utterance_id",
    "output_device_id",
    "device_generation",
    "output_epoch",
    "voice_id",
    "text",
    "created_at",
    "expires_at"
  ],
  "title": "VoicePlaybackCommand",
  "type": "object"
}
