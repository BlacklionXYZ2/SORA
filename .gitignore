/.venv/
/.local/
/.pytest_cache/
/.mypy_cache/
/.ruff_cache/
/**/__pycache__/
*.py[cod]
*.egg-info/
/SORA.zip

# Runtime state and secrets are deliberately outside versioned source.
/.env
/data/
*.db
*.db-*

# Generated C#/Unity build products are not source.
/clients/**/bin/
/clients/**/obj/
/clients/**/*.csproj.user
/clients/unity/Library/
/clients/unity/Temp/
/clients/unity/Logs/
/clients/unity/Builds/
/clients/unity/UserSettings/

# Large third-party assets, re-downloadable from their source. The bundled sample avatar is
# Seed-san (VRM Public License 1.0, see AVATAR_LICENSE.md beside it):
# https://github.com/vrm-c/vrm-specification/blob/master/samples/Seed-san/vrm/Seed-san.vrm
*.vrm

# Local build output and stray artefacts created outside the source tree layout.
/dist/
/tmp_test/
/%SystemDrive%/

# Public datasets downloaded for training the memory layers: large, licensed separately, and
# not part of SORA. Only the note saying what each one is used for is kept.
/training/memory/datasets/*
!/training/memory/datasets/README.md
